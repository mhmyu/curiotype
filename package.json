{
  "name": "typing",
  "version": "0.1.0",
  "description": "Typing practice with sentences that teach you something.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmyu/curiotype.git"
  },
  "bugs": {
    "url": "https://github.com/mhmyu/curiotype/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:favicon-ico": "node scripts/generate-favicon-ico.mjs",
    "assets:screenshots": "node scripts/generate-manifest-screenshots.mjs",
    "content:stats": "node scripts/content-stats.ts",
    "content:check-sources": "node scripts/check-sources.ts",
    "content:add-category": "node scripts/add-category.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.15.0"
}
