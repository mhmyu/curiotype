# Copy this file to `.env` for local use, or set the same names in your host's dashboard.
# Every value is optional: leave it empty and the feature that needs it is hidden or off.

# Public origin of the deployed site, without a path, for example https://typing.example.com
# Enables canonical and hreflang links, Open Graph URLs, the sitemap and the sitemap line in robots.txt.
SITE_URL=

# Public GitHub repository, https://github.com/<owner>/<repo>
# Enables the repository link in the footer and the "Report a wrong fact" links under each sentence.
PUBLIC_REPO_URL=

# Site token of Cloudflare Web Analytics (Cloudflare dashboard, Analytics & Logs, Web Analytics,
# add the site, then copy the token from the JS snippet; the 32 characters after "token").
# Enables privacy-friendly analytics (no cookies, no personal data) and, at build time, allows
# Cloudflare's two hosts in the Content Security Policy. Leave empty for no analytics at all.
PUBLIC_ANALYTICS_CLOUDFLARE_TOKEN=
