---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { getCollection } from 'astro:content';
import HomeContent from '@/components/HomeContent.astro';
import TypingTest from '@/features/typing-test/TypingTest.svelte';
import { LANGUAGES } from '@/i18n/config';
import type { Language } from '@/i18n/config';
import { getDictionary } from '@/i18n';
import { resolveContentLang } from '@/lib/content-langs';
import { getCategoryLabel } from '@/lib/categories';
import { getCategories } from '@/lib/get-categories';
import { getContentLangs } from '@/lib/get-content-langs';
import { pickHomeExamples } from '@/lib/home-examples';
import { buildSentences } from '@/lib/sentence-corpus';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const ui = getDictionary(lang);

// Sentence languages come from the folders under src/content/sentences/. The test starts in the
// interface language when it has sentences, otherwise in the default language (or the first one).
const contentLangs = await getContentLangs();
const contentLang = resolveContentLang(lang, contentLangs);
// Categories come from src/content/categories.json and the sentence files: per sentence language,
// only the categories that have a file there.
const categories = await getCategories();

// Static block under the test: the categories and three fixed example sentences of the starting
// sentence language (chosen by id, so the page is the same on every build of the same content).
const startCategories = categories.byLang[contentLang] ?? [];
const corpus = buildSentences(await getCollection('sentences', ({ data }) => data.lang === contentLang));
const examples = pickHomeExamples(
  corpus,
  startCategories.map((category) => category.id),
);
const categoryLabels = startCategories.map((category) => getCategoryLabel(startCategories, category.id, lang));
---

<BaseLayout lang={lang} preloadTypingFont preloadSentencesLang={contentLang} jsonLd>
  <h1 class="mb-2">{ui.meta.homeHeading}</h1>
  <p class="mb-6 font-ui text-body-long text-text-muted">{ui.meta.tagline}</p>
  <TypingTest
    client:load
    lang={lang}
    ui={ui}
    contentLangs={contentLangs}
    categories={categories.byLang}
    initialContentLang={contentLang}
    repoUrl={siteConfig.repoUrl}
  />
  <HomeContent ui={ui} categoryLabels={categoryLabels} examples={examples} />
</BaseLayout>
