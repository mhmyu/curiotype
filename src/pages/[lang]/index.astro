---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import HomeContent from '@/components/HomeContent.astro';
import TypingTest from '@/features/typing-test/TypingTest.svelte';
import { LANGUAGES } from '@/i18n/config';
import type { Language } from '@/i18n/config';
import { getDictionary, getLocalePath } from '@/i18n';
import { resolveContentLang } from '@/lib/content-langs';
import { getCategories } from '@/lib/get-categories';
import { getContentLangs } from '@/lib/get-content-langs';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const ui = getDictionary(lang);

// Sentence languages come from the folders under src/content/sentences/. The test starts in the
// interface language when it has sentences, otherwise in the default language (or the first one).
const contentLangs = await getContentLangs();
const contentLang = resolveContentLang(lang, contentLangs);
// Categories come from src/content/categories.json and the sentence files: per sentence language,
// only the categories that have a file there.
const categories = await getCategories();
// The guide hint is one sentence with a `{link}` placeholder; split it so the link is a real anchor.
const [hintBefore = '', hintAfter = ''] = ui.home.guideHint.text.split('{link}');
---

<BaseLayout lang={lang} preloadTypingFont preloadSentencesLang={contentLang} jsonLd>
  <h1 class="mb-2">{ui.meta.homeHeading}</h1>
  <p class="mb-2 font-ui text-body-long text-text-muted">{ui.meta.tagline}</p>
  <!-- In the first HTML, so it moves nothing when the test loads. One short line, so the test stays high on a phone. -->
  <p class="mb-6 font-ui text-caption text-text-muted" data-testid="guide-hint">
    {hintBefore}<a href={getLocalePath(lang, 'guide')} class="text-accent underline">{ui.home.guideHint.link}</a>{hintAfter}
  </p>
  <TypingTest
    client:load
    lang={lang}
    ui={ui}
    contentLangs={contentLangs}
    categories={categories.byLang}
    initialContentLang={contentLang}
    repoUrl={siteConfig.repoUrl}
  />
  <HomeContent lang={lang} ui={ui} />
</BaseLayout>
