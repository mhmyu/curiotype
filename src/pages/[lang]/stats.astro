---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsPage from '@/features/stats/StatsPage.svelte';
import { LANGUAGES } from '@/i18n/config';
import type { Language } from '@/i18n/config';
import { getDictionary } from '@/i18n';
import { resolveContentLang } from '@/lib/content-langs';
import { getContentLangs } from '@/lib/get-content-langs';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const ui = getDictionary(lang);

// Same rule as the home page: the sentence language starts as the interface language when it
// has sentences, otherwise the default language (or the first one).
const contentLangs = await getContentLangs();
const contentLang = resolveContentLang(lang, contentLangs);
---

<BaseLayout lang={lang} path="stats" title={ui.stats.title} description={ui.stats.description}>
  <h1 class="mb-6">{ui.stats.title}</h1>
  <StatsPage
    client:load
    lang={lang}
    ui={ui}
    contentLangs={contentLangs}
    initialContentLang={contentLang}
  />
</BaseLayout>
