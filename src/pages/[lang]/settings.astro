---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DataTools from '@/features/data-tools/DataTools.svelte';
import SettingsPanel from '@/features/settings/SettingsPanel.svelte';
import { LANGUAGES } from '@/i18n/config';
import type { Language } from '@/i18n/config';
import { getDictionary, getLocalePath } from '@/i18n';
import { resolveContentLang } from '@/lib/content-langs';
import { getContentLangs } from '@/lib/get-content-langs';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const ui = getDictionary(lang);

// Same rule as the home page: the sentence language starts as the interface language when it
// has sentences, otherwise the default language (or the first one).
const contentLangs = await getContentLangs();
const contentLang = resolveContentLang(lang, contentLangs);
---

<BaseLayout lang={lang} path="settings" title={ui.settings.title} description={ui.settings.description}>
  <h1 class="mb-6">{ui.settings.title}</h1>
  <div class="flex flex-col gap-8">
    <SettingsPanel
      client:load
      lang={lang}
      ui={ui}
      contentLangs={contentLangs}
      initialContentLang={contentLang}
    />
    <DataTools client:load ui={ui} />
    <p>
      <a href={getLocalePath(lang, 'privacy')} class="inline-flex min-h-11 items-center text-accent underline">
        {ui.dataTools.privacyLink}
      </a>
    </p>
  </div>
</BaseLayout>
