---
import type { Language } from '@/i18n/config';
import { getLocalePath } from '@/i18n';
import type { Dictionary } from '@/i18n/types';

interface Props {
  lang: Language;
  ui: Dictionary;
}

const { lang, ui } = Astro.props;
const text = ui.home;
---

<!-- Static text under the test and the history: what the site is, what it offers, how it works. No script. -->
<section class="mt-12 flex flex-col gap-10" aria-label={text.sectionLabel} data-testid="home-content">
  <div class="flex flex-col gap-3">
    <h2>{text.aboutTitle}</h2>
    {text.aboutBody.map((paragraph) => <p class="text-body-long">{paragraph}</p>)}
  </div>

  <div class="flex flex-col gap-3">
    <h2>{text.howTitle}</h2>
    <ol class="flex flex-col gap-3">
      {
        text.steps.map((step, index) => (
          <li class="card flex gap-4 p-5">
            <span
              class="flex size-8 shrink-0 items-center justify-center rounded-xs border-2 border-on-primary bg-primary font-ui text-ui text-on-primary"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div class="flex flex-col gap-1">
              <h3>{step.title}</h3>
              <p class="text-body-long">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="flex flex-col gap-3">
    <h2>{text.featuresTitle}</h2>
    <p class="text-body-long">{text.featuresIntro}</p>
    <ul class="grid gap-3 sm:grid-cols-2" data-testid="home-features">
      {
        text.features.map((feature) => (
          <li class="card flex flex-col gap-1 p-5">
            <p class="font-ui text-ui">{feature.title}</p>
            <p class="text-body-long">{feature.body}</p>
          </li>
        ))
      }
      <li class="card flex flex-col items-start gap-1 p-5 sm:col-span-2" data-testid="home-guide-card">
        <p class="font-ui text-ui">{text.guideCard.title}</p>
        <p class="text-body-long">{text.guideCard.body}</p>
        <a href={getLocalePath(lang, 'guide')} class="inline-flex min-h-11 items-center text-accent underline">
          {text.guideCard.link}
        </a>
      </li>
    </ul>
  </div>

  <div class="flex flex-col gap-3">
    <h2>{text.whyTitle}</h2>
    {text.whyBody.map((paragraph) => <p class="text-body-long">{paragraph}</p>)}
  </div>

  <div class="flex flex-col gap-3">
    <h2>{text.faqTitle}</h2>
    <div class="flex flex-col gap-3" data-testid="home-faq">
      {
        text.faq.map((item) => (
          <div class="card flex flex-col gap-1 p-5">
            <h3>{item.question}</h3>
            <p class="text-body-long">{item.answer}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
