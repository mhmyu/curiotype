---
import { LANGUAGES, LANGUAGE_NAMES } from '@/i18n/config';
import type { Language } from '@/i18n/config';
import { getLocalePath } from '@/i18n';

interface Props {
  lang: Language;
  label: string;
}

const { lang, label } = Astro.props;
---

<nav aria-label={label}>
  <ul class="flex gap-2">
    {
      LANGUAGES.map((code) => (
        <li>
          <a
            href={getLocalePath(code)}
            hreflang={code}
            lang={code}
            aria-current={code === lang ? 'page' : undefined}
            title={LANGUAGE_NAMES[code]}
            class="btn uppercase"
          >
            {code}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
