---
import { LANGUAGES, LANGUAGE_NAMES } from '@/i18n/config';
import type { Language } from '@/i18n/config';
import { getLocalePath } from '@/i18n';

interface Props {
  lang: Language;
  label: string;
  /** Path of the current page inside its language ('' = home): each link leads to the same page in its language. */
  path?: string;
}

const { lang, label, path = '' } = Astro.props;
---

<nav aria-labelledby="language-label" class="language-nav">
  <!-- Visible caption inside the small-screen menu; screen readers get it as the nav name. -->
  <span id="language-label" class="language-label">{label}</span>
  <ul class="menu-list">
    {
      LANGUAGES.map((code) => (
        <li>
          <a
            href={getLocalePath(code, path)}
            hreflang={code}
            lang={code}
            aria-current={code === lang ? 'page' : undefined}
            title={LANGUAGE_NAMES[code]}
            class="menu-link uppercase"
          >
            {code}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
