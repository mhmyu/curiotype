---
import type { Dictionary } from '@/i18n/types';
import { getFingerBgClass } from '@/features/guide/finger-colors';
import { FINGER_NUMBERS, HANDS, keysForFinger } from '@/features/guide/keyboard-fingers';

interface Props {
  ui: Dictionary;
}

const { ui } = Astro.props;
const text = ui.guide.diagram;
---

<!-- The same information as the keyboard diagram, as text: which finger presses which keys. -->
<div class="overflow-x-auto" tabindex="0" role="region" aria-label={text.tableCaption}>
  <table class="w-full text-left" data-testid="finger-table">
    <caption class="sr-only">{text.tableCaption}</caption>
    <thead>
      <tr class="border-b-2 border-border">
        <th scope="col" class="py-2 pr-4 font-ui text-ui">{text.tableFinger}</th>
        <th scope="col" class="py-2 font-ui text-ui">{text.tableKeys}</th>
      </tr>
    </thead>
    <tbody>
      {
        HANDS.flatMap((hand) =>
          FINGER_NUMBERS.map((finger) => (
            <tr class="border-b border-border" data-finger={`${hand}-${finger}`}>
              <th scope="row" class="py-2 pr-4 align-top font-ui text-ui">
                <span class="inline-flex items-center gap-2">
                  <span
                    class={`inline-block size-4 shrink-0 rounded-xs border-2 border-on-primary ${getFingerBgClass(hand, finger)}`}
                    aria-hidden="true"
                    data-swatch={finger}
                  />
                  <span>
                    {text.handLetter[hand]}
                    {finger} · {text.fingerNames[hand][finger - 1]}
                  </span>
                </span>
              </th>
              <td class="py-2">
                <ul class="flex flex-wrap gap-1">
                  {keysForFinger(hand, finger).map((key) => (
                    <li>
                      <kbd class="kbd">{key.label}</kbd>
                    </li>
                  ))}
                </ul>
              </td>
            </tr>
          )),
        )
      }
    </tbody>
  </table>
</div>
